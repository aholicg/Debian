{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-skills"],
  "mcp": {
    "frida": {
      "type": "local",
      "command": [
        "frida-mcp"
      ]
    },
    "gdb": {
      "type": "local",
      "command": [
        "gdb-mcp"
      ]
    },
    "mitmproxy": {
      "type": "local",
      "command": [
        "mitmproxy-mcp"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest",
        "--headless"
      ]
    },
    "radare2": {
      "type": "local",
      "command": [
        "r2pm",
        "-r",
        "r2mcp"
      ]
    },
    "semgrep": {
      "type": "local",
      "command": [
        "semgrep",
        "mcp"
      ]
    },
    "sqlite": {
      "type": "local",
      "command": [
        "mcp-server-sqlite"
      ]
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics"
      ]
    }
  }
}
